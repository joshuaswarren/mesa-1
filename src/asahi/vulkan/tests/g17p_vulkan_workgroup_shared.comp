#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

shared uint scratch[64];

void main()
{
   uint id = gl_LocalInvocationIndex;
   scratch[id] = 0x100u + id * 17u;
   barrier();

   uint across_subgroup = scratch[id ^ 32u];
   uint permuted = scratch[(id * 7u + 11u) & 63u];
   output_buffer.values[id] =
      0x51000000u ^ (id << 16) ^ (across_subgroup + permuted);
}
