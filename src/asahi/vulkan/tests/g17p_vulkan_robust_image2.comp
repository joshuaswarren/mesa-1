#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8ui) uniform uimage2D target;
layout(set = 0, binding = 1, std430) buffer Output {
   uvec4 values[8];
} output_buffer;

void
main()
{
   uint lane = gl_GlobalInvocationID.x;
   ivec2 load_coord = ivec2(0, 0);
   if (lane == 1)
      load_coord = ivec2(2, 3);
   else if (lane == 2)
      load_coord = ivec2(4, 0);
   else if (lane == 3)
      load_coord = ivec2(0, 4);
   else if (lane == 4)
      load_coord = ivec2(-1, 0);
   else if (lane == 5)
      load_coord = ivec2(0, -1);

   /* One dynamic image instruction covers both in-range controls and all four
    * directions outside the 4x4 view. This stays within the existing generic
    * storage-image ABI instead of requiring one hardware texture state per
    * syntactically duplicated access. */
   output_buffer.values[lane] = imageLoad(target, load_coord);

   ivec2 store_coord = ivec2(3, 3);
   if (lane == 1)
      store_coord = ivec2(4, 0);
   else if (lane == 2)
      store_coord = ivec2(0, 4);
   else if (lane == 3)
      store_coord = ivec2(-1, 0);
   else if (lane == 4)
      store_coord = ivec2(0, -1);
   else if (lane == 5)
      store_coord = ivec2(4, 4);

   uvec4 store_value = lane == 0 ? uvec4(9, 8, 7, 6)
                                  : uvec4(0xde, 0xad, 0xbe, 0xef);
   imageStore(target, store_coord, store_value);
}
