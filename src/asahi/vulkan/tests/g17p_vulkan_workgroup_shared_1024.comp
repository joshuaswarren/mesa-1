#version 450

/* A full-size workgroup exchanging shared memory across a barrier. Every
 * lane's output depends on a value another lane wrote, so a lane that does not
 * run, or a barrier that does not cover it, shows up as a wrong word rather
 * than a missing one. */
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
   uint values[];
} output_buffer;

shared uint scratch[1024];

void main()
{
   uint id = gl_LocalInvocationIndex;
   scratch[id] = 0x100u + id * 17u;
   barrier();

   uint mirrored = scratch[1023u - id];
   uint across_subgroup = scratch[id ^ 32u];
   uint far = scratch[(id + 512u) & 1023u];
   output_buffer.values[id] =
      0x51000000u ^ (id << 12) ^ (mirrored + across_subgroup + far);
}
