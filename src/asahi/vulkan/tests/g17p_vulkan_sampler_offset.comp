#version 450
#extension GL_EXT_samplerless_texture_functions : require
/* A storage buffer at binding 0 and a sampled image read with texelFetch at
 * binding 1: the same set offset as the graphics case, through compute. */
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0, std430) writeonly buffer Out { uint px[]; } o;
layout(set = 0, binding = 1) uniform utexture2D tex;
void main()
{
   ivec2 c = ivec2(gl_GlobalInvocationID.xy);
   uvec4 p = texelFetch(tex, c, 0);
   o.px[c.y * 4 + c.x] = p.r | (p.g << 8) | (p.b << 16) | (p.a << 24);
}
