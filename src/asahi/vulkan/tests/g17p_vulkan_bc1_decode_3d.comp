#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler3D compressed_image;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
   uint pixels[];
} output_data;

void
main()
{
   vec3 coord = vec3(gl_GlobalInvocationID.xy,
                     gl_GlobalInvocationID.z + 1);
   vec4 color = textureLod(compressed_image,
                           (coord + vec3(0.5)) / vec3(8.0, 8.0, 4.0), 0.0);
   uint index = gl_GlobalInvocationID.z * 64 +
                gl_GlobalInvocationID.y * 8 + gl_GlobalInvocationID.x;
   output_data.pixels[index] = packUnorm4x8(color);
}
