#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Counters {
   uint values[];
} counters;

void main()
{
   uint counter = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
   atomicAdd(counters.values[counter], gl_LocalInvocationIndex + 1u);
}
