#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_cull_mask : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevel;
layout(binding = 1, set = 0) buffer Result { uint values[]; } result;

layout(location = 0) rayPayloadEXT uint payload;

void main()
{
   payload = 0u;

   vec3 origin = vec3(float(gl_LaunchIDEXT.x) + 0.5,
                      float(gl_LaunchIDEXT.y) + 0.5, 0.0);

   traceRayEXT(topLevel, gl_RayFlagsNoneEXT, 0xFFu, 0u, 0u, 0u, origin, 0.0,
               vec3(0.0, 0.0, 1.0), 100.0, 0);

   uint index = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
   result.values[index] = payload;
}
