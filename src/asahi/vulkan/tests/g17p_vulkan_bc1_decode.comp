#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D compressed_image;
layout(set = 0, binding = 1, std430) writeonly buffer Output {
   uint pixels[];
} output_data;

void
main()
{
   ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
   vec4 color = texelFetch(compressed_image, coord, 0);
   output_data.pixels[coord.y * 8 + coord.x] = packUnorm4x8(color);
}
