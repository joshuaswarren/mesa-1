#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

/* vkQuake produces its whole world draw on the GPU.  This reproduces the
 * resource shape and the control flow of its brush-culling kernel: six
 * std430 buffers and a 28-byte push-constant block, a visibility bitmask
 * test, a backface test against a per-surface plane, an atomicAdd on the
 * indirect command's indexCount whose *return value* is the destination for
 * a dynamically bounded triangle-fan index write.
 *
 * Nothing here is cosmetic.  The shape is what the G17P native compute
 * admission gate in hk_cmd_dispatch.c measures: preamble, scratch, sampler
 * and texture state, and root set count.  A trivial two-buffer kernel
 * records where this one may not.
 */

layout (push_constant) uniform PushConsts
{
	uint  num_draws;
	uint  first_draw;
	uint  visibility_offset;
	float vieworg_x;
	float vieworg_y;
	float vieworg_z;
	uint  instance_base;
}
push_constants;

struct draw_indirect_command_t
{
	uint indexCount;
	uint instanceCount;
	uint firstIndex;
	int	 vertexOffset;
	uint firstInstance;
};

struct surface_t
{
	float normal_x;
	float normal_y;
	float normal_z;
	float dist;
	uint  packed_tex_edgecount;
	uint  vbo_offset;
	uint  packed_lightstyles;
	uint  packed_light_st;
};

struct bmodel_instance_t
{
	vec4 local_vieworg;
};

layout (std430, set = 0, binding = 0) restrict buffer indirect_draw_buffer
{
	draw_indirect_command_t indirect_draw_data[];
};
layout (std430, set = 0, binding = 1) restrict readonly buffer surfaces_buffer
{
	surface_t surfaces[];
};
layout (std430, set = 0, binding = 2) restrict readonly buffer visibility_buffer
{
	uint visibility[];
};
layout (std430, set = 0, binding = 3) restrict buffer ib
{
	uint indices[];
};
layout (std430, set = 0, binding = 4) restrict readonly buffer surface_submodels_buffer
{
	uint surface_submodels[];
};
layout (std430, set = 0, binding = 5) restrict readonly buffer instances_buffer
{
	bmodel_instance_t bmodel_instances[];
};

uint NumTriangleIndicesForSurf (uint edges)
{
	return 3 * (edges - 2);
}

void TriangleIndicesForSurf (uint firstvert, uint numedges, uint dest)
{
	for (uint i = 2; i < numedges; i++)
	{
		indices[dest++] = firstvert;
		indices[dest++] = firstvert + i - 1;
		indices[dest++] = firstvert + i;
	}
}

layout (local_size_x = 64, local_size_y = 1) in;
void main ()
{
	const uint surf = gl_GlobalInvocationID.x + push_constants.first_draw;
	if (surf >= push_constants.num_draws)
		return;

	const uint vis_word = visibility[push_constants.visibility_offset + surf / 32];
	const uint vis_mask = 1 << (surf % 32);
	if ((vis_word & vis_mask) == 0)
		return;

	const uint	packed_submodel = surface_submodels[surf];
	const uint	submodel = packed_submodel & 0x7FFFFFFFu;
	const vec3	surf_normal = vec3 (surfaces[surf].normal_x, surfaces[surf].normal_y, surfaces[surf].normal_z);
	const vec3	vieworg = (submodel != 0) ? bmodel_instances[push_constants.instance_base + submodel].local_vieworg.xyz
										  : vec3 (push_constants.vieworg_x, push_constants.vieworg_y, push_constants.vieworg_z);
	const float dist = surfaces[surf].dist;
	const float dp = dot (surf_normal, vieworg);
	const bool	backface = (surfaces[surf].packed_tex_edgecount & 0x8000) != 0;
	if (backface && dp > dist || !backface && dp < dist)
		return;

	const uint tex_idx = surfaces[surf].packed_tex_edgecount & 0x7FFF;
	const uint numedges = surfaces[surf].packed_tex_edgecount >> 16;
	const uint firstvert = surfaces[surf].vbo_offset;
	const uint indexcount = NumTriangleIndicesForSurf (numedges);
	const uint dest = indirect_draw_data[tex_idx].firstIndex + atomicAdd (indirect_draw_data[tex_idx].indexCount, indexcount);
	TriangleIndicesForSurf (firstvert, numedges, dest);
}
