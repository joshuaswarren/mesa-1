#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 32) in;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevel;
layout(binding = 1, set = 0) buffer Result { uint values[]; } result;

void main()
{
   rayQueryEXT rq;
   rayQueryInitializeEXT(rq, topLevel, gl_RayFlagsOpaqueEXT, 0xFFu,
                         vec3(0.5, 0.5, 0.0), 0.0, vec3(0.0, 0.0, 1.0), 10.0);

   while (rayQueryProceedEXT(rq)) { }

   result.values[gl_GlobalInvocationID.x] =
      uint(rayQueryGetIntersectionTypeEXT(rq, true));
}
