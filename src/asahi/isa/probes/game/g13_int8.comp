#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
/* shaderInt8 arithmetic held entirely in registers. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint8_t a = uint8_t(g);
   uint8_t b = uint8_t(a * uint8_t(5) + uint8_t(1));
   o.values[g] = uint(b);
}
