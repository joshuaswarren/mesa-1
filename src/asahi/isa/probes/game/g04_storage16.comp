#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
/* storageBuffer16BitAccess + shaderInt16. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Halves { uint16_t h[]; } s;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint16_t v = s.h[g];
   s.h[g] = uint16_t(v + uint16_t(9));
   o.values[g] = uint(v);
}
