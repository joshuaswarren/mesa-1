#version 450
#extension GL_KHR_shader_subgroup_ballot : require
/* VK_SUBGROUP_FEATURE_BALLOT_BIT is advertised. SM6 wave intrinsics
 * (WaveActiveBallot / WaveIsFirstLane) lower to exactly this. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uvec4 mask = subgroupBallot(g < 16u);
   o.values[g] = mask.x + subgroupBallotBitCount(mask);
}
