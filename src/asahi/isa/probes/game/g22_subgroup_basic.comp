#version 450
#extension GL_KHR_shader_subgroup_basic : require
/* VK_SUBGROUP_FEATURE_BASIC_BIT: barrier + invocation/size builtins. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   subgroupBarrier();
   o.values[g] = gl_SubgroupInvocationID + gl_SubgroupSize;
}
