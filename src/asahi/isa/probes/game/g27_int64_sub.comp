#version 450
#extension GL_ARB_gpu_shader_int64 : require
/* shaderInt64 SUBTRACTION only, with no 64-bit addition anywhere in the
 * source.  agx_compile.c gates nir_lower_iadd64 on
 * agx_nir_has_alu64(nir, nir_op_iadd), which does not see nir_op_isub, while
 * nir_lower_iadd64 is what lowers both (nir_lower_int64.c). */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer In { uint64_t v[]; } s;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint64_t d = s.v[g] - s.v[g ^ 1u];
   o.values[g] = uint(d);
}
