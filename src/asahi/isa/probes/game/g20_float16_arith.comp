#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
/* shaderFloat16 held in registers, matching the C07f shapes that are
 * already hardware-qualified: half multiply and half add, no narrowing
 * convert of a 32-bit value. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer In { uint bits[]; } s;
void main() {
   uint g = gl_GlobalInvocationID.x;
   f16vec2 v = unpackFloat2x16(s.bits[g]);
   f16vec2 r = v * v + f16vec2(1.5hf, 2.5hf);
   o.values[g] = packFloat2x16(r);
}
