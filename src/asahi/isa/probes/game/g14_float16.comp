#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
/* shaderFloat16: SM6 min16float / half-precision engine maths. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   float16_t a = float16_t(g) * float16_t(0.5hf);
   float16_t b = a * a + float16_t(1.5hf);
   o.values[g] = uint(float(b) * 16.0);
}
