#version 450
#extension GL_EXT_nonuniform_qualifier : require
/* shaderSampledImageArrayNonUniformIndexing: the bindless texture shape
 * every D3D12 title and most D3D11 titles under DXVK end up emitting. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 3) uniform sampler2D tex[];
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint sel = g & 3u;
   vec4 c = texture(tex[nonuniformEXT(sel)], vec2(0.25, 0.75));
   o.values[g] = packUnorm4x8(c);
}
