#version 450
/* shaderStorageImageWriteWithoutFormat: D3D12 UAV writes under VKD3D. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 4, rgba8) uniform image2D img;
void main() {
   uint g = gl_GlobalInvocationID.x;
   imageStore(img, ivec2(int(g), 0), vec4(0.25, 0.5, 0.75, 1.0));
   o.values[g] = g;
}
