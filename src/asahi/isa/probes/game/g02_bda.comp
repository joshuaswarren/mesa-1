#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_ARB_gpu_shader_int64 : require
/* bufferDeviceAddress: a raw 64-bit pointer dereferenced in the shader.
 * VKD3D-Proton uses this for every root descriptor; DXVK 2.x uses it for
 * descriptor buffers and modern engines for bindless. */
layout(local_size_x = 32) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Ptr {
   uint values[];
};
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Handles { uint64_t addr; } h;
void main() {
   uint g = gl_GlobalInvocationID.x;
   Ptr p = Ptr(h.addr);
   o.values[g] = p.values[g] + 1u;
}
