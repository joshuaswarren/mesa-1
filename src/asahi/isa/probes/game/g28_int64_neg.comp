#version 450
#extension GL_ARB_gpu_shader_int64 : require
/* shaderInt64 NEGATION only.  agx_emit_alu lowers nir_op_ineg to
 * agx_iadd_to(dst, 0, -s0), i.e. the same 64-bit AGX_OPCODE_IADD as isub. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer In { int64_t v[]; } s;
void main() {
   uint g = gl_GlobalInvocationID.x;
   o.values[g] = uint(-s.v[g]);
}
