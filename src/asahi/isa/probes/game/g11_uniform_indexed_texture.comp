#version 450
/* Control for g10: the SAME array indexed by a dynamically uniform value.
 * shaderSampledImageArrayDynamicIndexing, a Vulkan 1.0 core feature that is
 * advertised true on every chip. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Sel { uint index; } s;
layout(set = 0, binding = 3) uniform sampler2D tex[4];
void main() {
   uint g = gl_GlobalInvocationID.x;
   vec4 c = texture(tex[s.index], vec2(0.25, 0.75));
   o.values[g] = packUnorm4x8(c);
}
