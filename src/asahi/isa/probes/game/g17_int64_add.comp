#version 450
#extension GL_ARB_gpu_shader_int64 : require
/* shaderInt64, additive only: no 64-bit multiply anywhere. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Input { uint64_t src[]; } i;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint64_t b = i.src[g] + 0x1122334455667788UL;
   o.values[g] = uint(b >> 32) ^ uint(b);
}
