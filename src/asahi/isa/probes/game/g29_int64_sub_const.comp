#version 450
#extension GL_ARB_gpu_shader_int64 : require
/* 64-bit subtraction with CONSTANT indices, so the descriptor-relative
 * offsets fold into the load/store immediate and no 64-bit iadd is left in
 * source NIR for agx_nir_has_alu64(nir, nir_op_iadd) to find. */
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer In { uint64_t v[]; } s;
void main() {
   o.values[0] = uint(s.v[0] - s.v[1]);
}
