#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
/* VK_SUBGROUP_FEATURE_ARITHMETIC_BIT is advertised. WaveActiveSum and
 * WavePrefixSum lower here; used by every GPU-driven culling path. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   o.values[g] = subgroupAdd(g) + subgroupExclusiveAdd(g) + subgroupMax(g);
}
