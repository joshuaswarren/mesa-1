#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
/* storageBuffer8BitAccess + shaderInt8: byte-addressed SSBO traffic.
 * D3D12 byte-address buffers and every texture-streaming path use it. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Bytes { uint8_t b[]; } s;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint8_t v = s.b[g];
   s.b[g] = uint8_t(v + uint8_t(7));
   o.values[g] = uint(v);
}
