#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
/* shaderInt16 arithmetic held entirely in registers (no 16-bit storage). */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint16_t a = uint16_t(g);
   uint16_t b = uint16_t(a * uint16_t(7) + uint16_t(3));
   o.values[g] = uint(b);
}
