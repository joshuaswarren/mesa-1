#version 450
#extension GL_KHR_shader_subgroup_quad : require
/* VK_SUBGROUP_FEATURE_QUAD_BIT is advertised (QuadReadAcrossX/Y). */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   o.values[g] = subgroupQuadSwapHorizontal(g) + subgroupQuadSwapVertical(g) +
                 subgroupQuadBroadcast(g, 2u);
}
