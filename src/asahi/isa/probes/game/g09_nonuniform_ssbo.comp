#version 450
#extension GL_EXT_nonuniform_qualifier : require
/* shaderStorageBufferArrayNonUniformIndexing + descriptorBindingPartiallyBound.
 * DXVK and VKD3D-Proton both require descriptor indexing; this is the
 * cheapest shape that actually exercises it. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 2, std430) buffer Table { uint v[]; } t[];
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint sel = g & 3u;
   o.values[g] = t[nonuniformEXT(sel)].v[g];
}
