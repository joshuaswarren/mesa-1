#version 450
/* Storage image LOAD only, no write: separates the read and write halves
 * of the storage-image path. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 4, rgba8) uniform readonly image2D img;
void main() {
   uint g = gl_GlobalInvocationID.x;
   o.values[g] = packUnorm4x8(imageLoad(img, ivec2(int(g), 0)));
}
