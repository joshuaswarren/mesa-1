#version 450
#extension GL_KHR_shader_subgroup_vote : require
/* VK_SUBGROUP_FEATURE_VOTE_BIT (WaveActiveAllTrue / AnyTrue). */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   o.values[g] = (subgroupAll(g < 32u) ? 1u : 0u) +
                 (subgroupAny(g == 0u) ? 2u : 0u);
}
