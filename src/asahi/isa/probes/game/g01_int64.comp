#version 450
#extension GL_ARB_gpu_shader_int64 : require
/* shaderInt64: 64-bit integer arithmetic, required by VKD3D-Proton for
 * D3D12 64-bit atomics/addresses and used by every modern engine that
 * carries a 64-bit handle in a constant buffer. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
layout(set = 0, binding = 1, std430) buffer Input { uint64_t src[]; } i;
void main() {
   uint g = gl_GlobalInvocationID.x;
   uint64_t a = i.src[g];
   uint64_t b = a * 3UL + 0x1122334455667788UL;
   o.values[g] = uint(b >> 32) ^ uint(b);
}
