#version 450
/* 32-bit SSBO atomics: D3D11/12 append-consume counters and every
 * GPU-driven pipeline. The packer matrix already records these as encoding;
 * this case additionally proves they RECORD on the G17P native path. */
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } o;
void main() {
   uint g = gl_GlobalInvocationID.x;
   atomicAdd(o.values[0], g);
}
