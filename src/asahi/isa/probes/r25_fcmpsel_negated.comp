#version 450
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } output_buffer;
layout(set = 0, binding = 1, std430) buffer Input { float elems[]; } second_buffer;
#define values output_buffer.values
#define input_floats second_buffer.elems
void main() {
   uint g = gl_GlobalInvocationID.x;
   float a = input_floats[2u * g];
   float b = input_floats[2u * g + 1u];
   values[g] = (-a > b) ? 1u : 0u;
}
