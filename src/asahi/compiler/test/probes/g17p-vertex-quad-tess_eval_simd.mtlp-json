{
  "pipelines": {
    "render_pipelines": [
      {
        "vertex_function": "tess_eval_simd",
        "fragment_function": "frag_pass",
        "input_primitive_topology": "Triangle",
        "raster_sample_count": 1,
        "vertex_descriptor": {
          "attributes": [ { "format": "Float4", "offset": 0, "buffer_index": 0 } ],
          "layouts": [ { "stride": 16, "step_function": "PerPatchControlPoint", "step_rate": 1 } ]
        },
        "tessellation_partition_mode": "Integer",
        "tessellation_output_winding_order": "Clockwise",
        "tessellation_factor_step_function": "Constant",
        "tessellation_control_point_index_type": "None",
        "tessellation_factor_format": "Half",
        "max_tessellation_factor": 16,
        "color_attachments": [
          { "pixel_format": "RGBA32Float", "write_mask": "All", "blending_enabled": false }
        ]
      }
    ]
  }
}
