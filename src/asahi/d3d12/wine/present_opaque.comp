// Present the shared GPU image while forcing H17P DCP's alpha/X bits opaque.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) writeonly uniform image2D target;
layout(set = 0, binding = 1) uniform sampler2D source_image;
void main()
{
   ivec2 p = ivec2(gl_GlobalInvocationID.xy);
   ivec2 size = imageSize(target);
   if (any(greaterThanEqual(p, size)))
      return;
   vec4 color = textureLod(source_image, (vec2(p) + 0.5) / vec2(size), 0.0);
   color.a = 1.0;
   imageStore(target, p, color);
}
