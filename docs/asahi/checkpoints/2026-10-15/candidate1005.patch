+   nir_builder_instr_insert(b, &probe->instr);
+   int comparator = nir_tex_instr_src_index(probe, nir_tex_src_comparator);
+   assert(comparator >= 0);
+   nir_src_rewrite(&probe->src[comparator].src, ref);
+   if (clamp_to_zero)
+      probe->backend_flags |= AGX_TEXTURE_FLAG_CLAMP_TO_0;
+   return probe;
+}
